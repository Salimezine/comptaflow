{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "comptaflow-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "r2_buckets": [
    { "binding": "PDF_BUCKET", "bucket_name": "comptaflow-pdfs" }
  ],
  "d1_databases": [
    { "binding": "DB", "database_name": "comptaflow-db", "database_id": "<DATABASE_ID>" }
  ],
  "vars": {
    "ENVIRONMENT": "production"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
